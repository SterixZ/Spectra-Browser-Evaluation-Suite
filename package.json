{
  "name": "browserperformance",
  "version": "2.0.0",
  "description": "Spectra Cross-Browser Performance Evaluation Platform (Raj Jain Methodology)",
  "main": "spectra.js",
  "bin": {
    "spectra": "./spectra.js"
  },
  "scripts": {
    "bench": "node spectra.js run --suite standard",
